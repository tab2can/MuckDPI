<Window x:Class="MuckDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuckDPI"
        Height="720" Width="520"
        MinHeight="640" MinWidth="460"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        StateChanged="OnStateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="52" Background="#101118" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragWindow">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Background="#2A2416" Margin="0,0,10,0">
            <TextBlock Text="M" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="MuckDPI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="─" Width="36" Height="28" Style="{StaticResource GhostBtn}" Padding="0" Click="Minimize" Margin="0,0,6,0"/>
          <Button Content="✕" Width="36" Height="28" Style="{StaticResource GhostBtn}" Padding="0" Click="CloseClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Türkiye DPI koruması" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Windows servisi olarak çalışır: bilgisayar açılınca koruma gelir, pencereyi kapatsanız da açık kalır. Tarayıcıyı kapatıp açmanız gerekmez."/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding AccentStatus}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding IspLine}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StrategyLine}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,14" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Korumayı başlat" Style="{StaticResource PrimaryBtn}" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
              <Button Content="Durdur" Style="{StaticResource GhostBtn}" Command="{Binding StopCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource BadBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatsLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Hattı tara" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Önce korumasız ölçer, sonra Türkiye'de sık kesilen sitelerde yöntemleri dener ve en iyisini uygular. 1–2 dakika sürebilir."/>
            <Button Content="Tara ve en iyisini uygula" Style="{StaticResource PrimaryBtn}" Command="{Binding TuneCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding TuneProgress}" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Günlük" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="220"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#0A0B10"/>
            <CheckBox Content="Windows ile başlat (servis + tepsi)" IsChecked="{Binding WindowsIntegrate}" Margin="0,10,0,0"/>
            <CheckBox Content="Kapatmak yerine tepsiye küçült" IsChecked="{Binding MinimizeToTray}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
