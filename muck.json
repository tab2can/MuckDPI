{
  "id": "com.tab2can.muckdpi",
  "name": "MuckDPI",
  "version": "1.3.0",
  "license": "MIT",
  "summary": "Windows DPI circumvention that tunes on first run and stays as a background service.",
  "description": "MuckDPI detects your ISP, tests blocked sites, applies the best desync profile system-wide, and keeps running as a Windows service from boot. Re-run with -test. No tray app after setup.",
  "categories": ["network", "utilities"],
  "tags": ["dpi", "goodbyeDPI", "zapret", "windows", "muck-store"],
  "source": { "github": "tab2can/MuckDPI" },
  "entry": "MuckDPI.exe",
  "install": {
    "kind": "archive",
    "assets": [
      {
        "file": "muckdpi.zip",
        "platform": "windows-x64",
        "sha256": "e1c1f46c0f79da397e883ee9b82deaf7acd5eacbdf26bac318b968aa28803bc0"
      }
    ],
    "shortcuts": { "startMenu": true, "desktop": false }
  },
  "build": {
    "workflow": ".github/workflows/release.yml",
    "reproducible": true,
    "attestations": "required"
  },
  "permissions": [
    "admin",
    "network",
    "filesystem",
    "autostart",
    "notifications",
    "other-process"
  ],
  "filesystemPaths": [
    "%APPDATA%\\MuckDPI\\*",
    "%APPDATA%\\MuckStore\\config\\com.tab2can.muckdpi.json"
  ],
  "update": { "channel": "github-releases", "includePrerelease": false },
  "watchdog": { "onCrash": "notify", "maxRestarts": 0 },
  "i18n": {
    "tr": {
      "name": "MuckDPI",
      "summary": "İlk açılışta hattı tarar, sonra Windows servisi olarak arka planda kalır.",
      "description": "MuckDPI ISS'nizi tanır, yasaklı sitelerde yöntemleri dener, en iyi profili tüm sisteme uygular ve açılıştan itibaren Windows servisi olarak çalışır. Yeniden tarama: -test."
    }
  },
  "ui": {
    "icon": "docs/icon.png",
    "accent": "#e8b84a"
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "default": "tr", "title": "Language" },
        "strategyId": { "type": "string", "default": "auto", "title": "Strategy" },
        "ispId": { "type": "string", "default": "auto", "title": "ISP" },
        "dnsProvider": { "type": "string", "default": "cloudflare", "title": "DNS" },
        "enableDnsProtect": { "type": "boolean", "default": true },
        "autoStartEngine": { "type": "boolean", "default": false }
      }
    }
  }
}
